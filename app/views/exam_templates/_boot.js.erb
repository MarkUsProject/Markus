let cropper;

document.addEventListener("DOMContentLoaded", function () {
  window.modal_create_new = new ModalMarkus("#create_new_template");
  $("#generate_exam_modal_submit").click(() => {
    $("#generate_exam_dialog").trigger("closeModal");
  });
  $(".add-template-division").click(e => {
    add_template_division(e.target);
    e.preventDefault();
  });
});

document.addEventListener("DOMContentLoaded", () => {
  createConsumer().subscriptions.create(
    {channel: "ExamTemplatesChannel", course_id: <%= @current_course.id %>},
    {
      received(data) {
        if (data["status"] !== null) {
          const message_data = generateMessage(data);
          renderFlashMessages(message_data);
          if (data["status"] === "completed") {
            handleJobCompletion(data);
          }
        }
      },
      connected() {},
      disconnected() {},
    }
  );
});

function generateMessage(status_data) {
  let message_data = {};
  switch (status_data["status"]) {
    case "queued":
      message_data["notice"] = I18n.t("poll_job.queued");
      break;
    case "in_progress":
      if (status_data["job_class"] === "SplitPdfJob") {
        message_data["notice"] = status_data["message"];
      } else if (status_data["job_class"] === "GenerateJob") {
        const status_details = {
          progress: status_data["page_number"],
          total: status_data["total_pages"],
          exam_name: status_data["exam_name"]
        };
        message_data["notice"] = I18n.t("poll_job.generate_job", status_details);
      }
      break;
    case "completed":
      message_data["success"] = I18n.t("poll_job.completed");
      break;
    case "failed":
      if (status_data["exception"]) {
        message_data["error"] = I18n.t("job.status.failed.message", {
          error: status_data["exception"],
        });
      } else {
        message_data["error"] = I18n.t("job.status.failed.no_message");
      }
      break;
  }
  return message_data;
}

function handleJobCompletion(status_data) {
  if (status_data["job_class"] === "SplitPdfJob") {
    window.location.reload();
  } else if (status_data["job_class"] === "GenerateJob") {
    window.location = Routes.download_generate_course_exam_template_path(
      status_data["course_id"],
      status_data["exam_id"],
      {file_name: status_data["file_name"]}
    );
  }
}

/**
 * Initialize an exam template form.
 * @param id Exam template id
 */
const init_exam_template_form = id => {
  const form = document.getElementById(`add_fields_exam_template_form_${id}`);
  const parsing_input = form && form.elements[`${id}_exam_template_automatic_parsing`];

  parsing_input.addEventListener("change", () => toggle_cover_page(id));

  const crop_target = form.querySelector("img");
  crop_target.onload = () => toggle_cover_page(id);
};

function add_template_division(target) {
  var new_id = new Date().getTime();
  var nested_form_path = `exam_template[template_divisions_attributes][${new_id}]`;
  var input_id = "exam_template_template_divisions_attributes" + new_id;
  var new_division_row = `
    <tr id="${input_id}_holder" class="new">
      <td>
        <input type="text" required="required" name="${nested_form_path}[label]" autocomplete="off">
      </td>
      <td>
        <input type="number" min="2" required="required" name="${nested_form_path}[start]" autocomplete="off">
      </td>
      <td>
        <input type="number" min="2" required="required" name="${nested_form_path}[end]" autocomplete="off">
      </td>
      <td>
        <a href="#" class="delete-exam-template-row">
          ${I18n.t("delete")}
        </a>
      </td>
    </tr>
    `;
  $(target).parent(".table-with-add").find("tbody").append(new_division_row);
  $(".delete-exam-template-row").click(e => {
    $(e.target).parents("tr").remove();
    e.preventDefault();
  });
}

function toggle_cover_page(id) {
  const form = document.getElementById(`add_fields_exam_template_form_${id}`);
  const parsing_input = form && form.elements[`${id}_exam_template_automatic_parsing`];
  if (parsing_input === null || parsing_input === undefined) {
    return;
  }

  if (parsing_input.checked) {
    $("#exam-cover-display-" + id).css("display", "flex");

    attach_crop_box(id);
  } else {
    $("#exam-cover-display-" + id).css("display", "none");
  }
}

/**
 * Initialize a crop object and attach a crop box to an exam template's cover page image, using
 * form data to specify the dimensions of the crop box. If the form data does not exist, the crop
 * box defaults to covering most of the image.
 * @param id Exam template identifier.
 */
function attach_crop_box(id) {
  const form = document.getElementById(`add_fields_exam_template_form_${id}`);
  const crop_target = form.querySelector("img");

  if (cropper !== undefined) {
    cropper.destroy();
  }

  const saved_selection = get_saved_selection(crop_target, form, id);

  cropper = new Cropper(crop_target, {
    viewMode: 1,
    dragMode: "crop",
    autoCrop: true,
    autoCropArea: saved_selection ? 1 : 0.8,
    movable: false,
    rotatable: false,
    scalable: false,
    zoomable: false,
    background: false,
    data: saved_selection,
    crop: event => {
      const {naturalWidth, naturalHeight} = crop_target;
      const {x, y, width, height} = event.detail;

      form.elements[`${id}_exam_template_crop_x`].value = x / naturalWidth;
      form.elements[`${id}_exam_template_crop_y`].value = y / naturalHeight;
      form.elements[`${id}_exam_template_crop_width`].value = width / naturalWidth;
      form.elements[`${id}_exam_template_crop_height`].value = height / naturalHeight;
    },
  });
}

/**
 * Compute the previously saved crop selection (in natural image pixel coordinates), given a
 * selection has been saved.
 * @param crop_target Target the crop selection was made on. Must be an exam template.
 * @param form Form containing information of the crop selection for the target (exam template).
 * @param id Exam template identifier.
 * @returns {{x: number, y: number, width: number, height: number}|undefined} Saved crop selection,
 *  or undefined if no selection has been saved.
 */
function get_saved_selection(crop_target, form, id) {
  const x = parseFloat(form.elements[`${id}_exam_template_crop_x`].value);
  const y = parseFloat(form.elements[`${id}_exam_template_crop_y`].value);
  const width = parseFloat(form.elements[`${id}_exam_template_crop_width`].value);
  const height = parseFloat(form.elements[`${id}_exam_template_crop_height`].value);

  if (isNaN(x) || isNaN(y) || isNaN(width) || isNaN(height)) {
    return undefined;
  }

  const {naturalWidth, naturalHeight} = crop_target;
  return {
    x: x * naturalWidth,
    y: y * naturalHeight,
    width: width * naturalWidth,
    height: height * naturalHeight,
  };
}

/**
 * Adds a submit event listener to the upload scans form.
 * The event listener checks the template divisions count of the template that was selected from the form dropdown
 * and shows a confirmation dialog on submission of the form if the selected template has no divisions assigned to it.
 * This function runs after the form is injected in view_logs.js.erb.
 * @param {Array} examTemplateData contains exam template ids and matching template division counts.
 * @returns {void}
 */
function init_upload_scans_form(examTemplateData) {
  const uploadScansForm = document.getElementById('upload_scans_form');
  const dropdown = document.getElementById('exam_template_dropdown');

  if (!uploadScansForm || !dropdown) {
    return;
  }

  uploadScansForm.addEventListener('submit', (e) => {
    const selectedExamTemplate = examTemplateData.find(template => String(template.exam_template_id) === dropdown.value);

    if (selectedExamTemplate && selectedExamTemplate.template_division_count === 0) {
      const proceed = confirm(I18n.t('exam_templates.upload_scans.confirmation_dialog'));
      if (!proceed) {
        e.preventDefault();
        e.stopPropagation();
      }
    }
  }, true);
}
